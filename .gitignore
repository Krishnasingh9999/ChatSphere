# =============================================================
# Root .gitignore for ChatSphere Microservices
# =============================================================

# 1. Dependencies (Never push node_modules)
node_modules/
**/node_modules/
.pnp
.pnp.js

# 2. Production Build Outputs (Auto-generated by build / vite / tsc)
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
**/out/
*.tsbuildinfo
**/*.tsbuildinfo

# 3. Environment Variables & Secrets (Keep API keys & passwords safe)
.env
**/.env
.env.*
**/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing template files
!.env.example
!**/.env.example

# 4. Uploaded Files & Temporary Media
uploads/
**/uploads/
Backend/chat/uploads/
Backend/user/uploads/
tmp/
**/tmp/
temp/
**/temp/

# 5. Logs & Debugging Files
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
**/npm-debug.log*
yarn-debug.log*
**/yarn-debug.log*
yarn-error.log*
**/yarn-error.log*
pnpm-debug.log*
**/pnpm-debug.log*

# 6. IDEs, Code Editors & OS Artifacts
.vscode/
**/.vscode/
!.vscode/extensions.json
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
desktop.ini
**/desktop.ini

# 7. Test & Coverage Outputs
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
